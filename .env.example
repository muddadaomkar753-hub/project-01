# AlphabetAI Attendance Environment Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
MONGO_URI=mongodb://127.0.0.1:27017/alphabetai_db
DB_NAME=alphabetai_db

# Computer Vision & Biometric Parameters
YUNET_MODEL_PATH=data/models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=data/models/face_recognition_sface_2021dec.onnx

# AI Verification Calibration
DETECTION_CONFIDENCE=0.70
SIMILARITY_MATCH_THRESHOLD=0.38
SIMILARITY_UNCERTAIN_THRESHOLD=0.30

# Quality Control
BLUR_THRESHOLD=30.0
MIN_BRIGHTNESS=35.0
MAX_BRIGHTNESS=230.0
MIN_FACE_SIZE=60

# Session Expiry (Seconds - 24 hours)
TOKEN_EXPIRY_SECONDS=86400
